{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retreat Planner",
  "version": "2.0.0+beta.7",
  "identifier": "com.cflory.retreatplanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Retreat Planner",
        "width": 1360,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://basemap.nationalmap.gov; connect-src 'self' ipc: http://ipc.localhost https://hydro.nationalmap.gov https://epqs.nationalmap.gov https://hazards.fema.gov https://geo.fcc.gov https://overpass-api.de"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "category": "Finance",
    "shortDescription": "Retirement survival-retreat planner",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/applications/retreat-planner.desktop": "linux/retreat-planner.desktop"
        }
      },
      "deb": {
        "depends": [],
        "desktopTemplate": "linux/hidden.desktop",
        "files": {
          "/usr/share/applications/retreat-planner.desktop": "linux/retreat-planner.desktop"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/hidden.desktop",
        "files": {
          "/usr/share/applications/retreat-planner.desktop": "linux/retreat-planner.desktop"
        }
      }
    }
  }
}
